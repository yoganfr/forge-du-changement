{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'; script-src 'self' 'sha256-iMvwttWUHtn5gjGmRk+V5swlmlBIXGphq5bFutnzT/4='"
        },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/auth/callback", "destination": "/index.html" },
    { "source": "/auth/confirm", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}